<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_generic" inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">1!=1</attribute>
        </xpath>

        <xpath expr="//span[@t-out=&quot;', '.join([(tax.invoice_label or tax.name) for tax in line.taxes_id])&quot;]" position="attributes">
            <attribute name="t-if">1!=1</attribute>
        </xpath>


    </template>
</odoo>