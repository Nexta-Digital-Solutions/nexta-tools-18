<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_deca_document"
              inherit_id="stock.report_delivery_document"
              primary="True">
        <xpath expr="//div[hasclass('page')]/div[@t-if='not o.signature']" position="before">
            <div class="mt-3 p-2"
                 name="deca_information"
                 style="border: 1px solid #dee2e6; page-break-inside: avoid; font-size: 11px; line-height: 1.2;">
                <div class="row align-items-start mb-2">
                    <div class="col-6">
                        <h4 class="mb-1" style="font-size: 16px;">Datos del documento de control (DeCA)</h4>
                        <strong>Fecha de generación</strong>
                        <div>
                            <span t-field="deca_document.generated_at"/>
                        </div>
                        <div class="mt-2">
                            <strong>Cargador contractual</strong>
                            <div t-if="o.company_id.partner_id"
                                 t-field="o.company_id.partner_id"
                                 t-options='{"widget": "contact", "fields": ["name", "address", "vat"], "no_marker": True}'/>
                            <div t-else="">—</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <strong>Transportista efectivo</strong>
                        <div t-if="o.deca_effective_carrier_id"
                             t-field="o.deca_effective_carrier_id"
                             t-options='{"widget": "contact", "fields": ["name", "vat"], "no_marker": True}'/>
                        <div t-else="">—</div>
                    </div>
                    <div class="col-3 text-end">
                        <strong>Documento digital</strong>
                        <br/>
                        <span t-out="deca_document.access_url"
                              t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 112, 'height': 112, 'img_style': 'width:28mm;height:28mm;'}"/>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-6">
                        <strong>Lugar de origen</strong>
                        <div t-if="o.warehouse_address_id"
                             t-field="o.warehouse_address_id"
                             t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                        <div t-elif="o.location_id">
                            <span t-field="o.location_id.complete_name"/>
                        </div>
                        <div t-else="">—</div>
                    </div>
                    <div class="col-6">
                        <strong>Lugar de destino</strong>
                        <div t-if="o.partner_id"
                             t-field="o.partner_id"
                             t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                        <div t-elif="o.location_dest_id">
                            <span t-field="o.location_dest_id.complete_name"/>
                        </div>
                        <div t-else="">—</div>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-4">
                        <strong>Fecha del transporte</strong>
                        <div t-if="o.state == 'done' and o.date_done">
                            <span t-field="o.date_done"/>
                        </div>
                        <div t-elif="o.scheduled_date">
                            <span t-field="o.scheduled_date"/>
                        </div>
                        <div t-else="">—</div>
                    </div>
                    <div class="col-4">
                        <strong>Peso</strong>
                        <div t-if="o.shipping_weight">
                            <span t-field="o.shipping_weight"/>
                            <span t-out="o.env['product.template']._get_weight_uom_name_from_ir_config_parameter()"/>
                        </div>
                        <div t-else="">—</div>
                    </div>
                    <div class="col-4">
                        <strong>Otra magnitud</strong>
                        <div t-out="o.deca_alternative_magnitude or '—'"/>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-12">
                        <strong>Naturaleza de la mercancía</strong>
                        <div t-out="o.deca_goods_nature or '—'"
                             style="white-space: pre-wrap;"/>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-4">
                        <strong>Autorización especial de circulación</strong>
                        <div t-out="o.deca_special_authorization or '—'"/>
                    </div>
                    <div class="col-4">
                        <strong>Matrícula del vehículo tractor</strong>
                        <div t-out="o.deca_vehicle_plate or '—'"/>
                    </div>
                    <div class="col-4">
                        <strong>Matrícula del remolque o semirremolque</strong>
                        <div t-out="o.deca_trailer_plate or '—'"/>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <strong>Observaciones o reservas</strong>
                        <div t-out="o.deca_observations or '—'"
                             style="white-space: pre-wrap;"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="report_delivery_deca">
        <t t-foreach="docs" t-as="o">
            <t t-call="stock_picking_normativa_deca.report_delivery_deca_document"
               t-lang="o._get_report_lang()"/>
        </t>
    </template>

    <record id="action_report_delivery_deca" model="ir.actions.report">
        <field name="name">Albarán de entrega DeCA</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_picking_normativa_deca.report_delivery_deca</field>
        <field name="report_file">stock_picking_normativa_deca.report_delivery_deca</field>
        <field name="print_report_name">'Albarán DeCA - %s' % object.name</field>
    </record>
</odoo>
